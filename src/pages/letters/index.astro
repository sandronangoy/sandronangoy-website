---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { fmtDate, byDateDesc } from '../../utils';
const letters = (await getCollection('letters', (e) => !e.data.draft)).sort(byDateDesc);
---
<Base title="Letters" description="Long-form quarterly letters from the Nangoy Foundation.">
  <section class="wrap" style="padding-top: 52px;">
    <p class="eyebrow">letters</p>
    <h1 style="font-weight:300;font-size:34px;margin:0 0 6px;">the long-form quarterlies.</h1>
    <p class="sub" style="color:var(--muted);margin:0 0 26px;">what I own, why I own it, and what I got wrong.</p>
    <a class="entry has-cover" href="/letters/september-2026.html">
      <Cover title="Monthly Letter — September 2026" tag="the nangoy foundation · september 2026" />
      <div class="entry-text">
        <div class="date">September 2026 · letter</div>
        <h3>Monthly Letter — September 2026</h3>
        <p>Yields up half a point in a month, a flat index hiding a bad month for the typical stock, a clean-up of the book, and why American Express’s closed loop is the moat people miss.</p>
      </div>
    </a>
    <a class="entry has-cover" href="/letters/august-2026.html">
      <Cover title="Monthly Letter — August 2026" tag="the nangoy foundation · august 2026" />
      <div class="entry-text">
        <div class="date">August 2026 · letter</div>
        <h3>Monthly Letter — August 2026</h3>
        <p>The month the market swung from pricing a cut to a hike, a monster NVIDIA quarter and why the price still worries me, and the book a line each.</p>
      </div>
    </a>
    {letters.map((l) => (
      <a class="entry has-cover" href={`/letters/${l.slug}/`}>
        <Cover title={l.data.title} tag={l.data.coverLabel} image={l.data.coverImage} />
        <div class="entry-text">
          <div class="date">{fmtDate(l.data.date)} · letter</div>
          <h3>{l.data.title}</h3>
          {l.data.dek && <p>{l.data.dek}</p>}
        </div>
      </a>
    ))}
  </section>
</Base>
